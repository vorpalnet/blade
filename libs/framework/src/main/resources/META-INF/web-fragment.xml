<?xml version="1.0" encoding="UTF-8"?>
<web-fragment xmlns="http://xmlns.jcp.org/xml/ns/javaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                                  http://xmlns.jcp.org/xml/ns/javaee/web-fragment_4_0.xsd"
              version="4.0">
    <!-- Declared here, not left to @WebListener scanning: in a SIP WAR the
         container was not registering the annotated LogManager, so its
         contextDestroyed never ran and the per-app FileHandler was never
         closed. That leaks the java.util.logging lock across redeploys, so a
         fresh deployment cannot reclaim <app>.0.log and rotates to
         <app>.0.log.1, .2, ... (the "two loggers running" duplicate-log
         symptom). Listed first so it initializes first and is therefore
         destroyed last, after the servlet's stop event is written. -->
    <listener>
        <listener-class>org.vorpal.blade.framework.v2.logging.LogManager</listener-class>
    </listener>
    <listener>
        <listener-class>org.vorpal.blade.framework.v2.logging.LogReaderRegistrar</listener-class>
    </listener>
    <listener>
        <listener-class>org.vorpal.blade.framework.v3.probe.KernelProbeRegistrar</listener-class>
    </listener>

    <!-- Cross-origin filter for REST endpoints. No-op until an operator sets
         -Dblade.cors.allowedOrigins=<origin>[,<origin>...]; then it grants
         credentialed CORS to those exact origins (e.g. the AdminServer origin
         the API Explorer is served from, so its live "try it" can reach the
         engine tier). HTTP-only and async-aware; SIP traffic never traverses
         servlet filters, so there is no CPS-path impact. -->
    <filter>
        <filter-name>BladeCorsFilter</filter-name>
        <filter-class>org.vorpal.blade.framework.cors.CorsFilter</filter-class>
        <async-supported>true</async-supported>
    </filter>
    <filter-mapping>
        <filter-name>BladeCorsFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <distributable/>
</web-fragment>
