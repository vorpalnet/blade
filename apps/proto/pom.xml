<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.vorpal.blade</groupId>
		<artifactId>vorpal-blade</artifactId>
		<version>${revision}</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<artifactId>vorpal-blade-proto-ear</artifactId>
	<packaging>ear</packaging>
	<name>BLADE Proto EAR</name>
	<description>Single deployable that bundles the proto/ incubator apps. Incubator only —
		these apps are not part of the shipping product; the EAR is a convenience
		for demoing the whole incubator at once. Each app is contributed by its
		ear-&lt;name&gt; profile (!skip.&lt;name&gt;), so it tracks the build profile.</description>

	<dependencies>
		<!-- WAR modules are contributed via the ear-* profiles below. No JARs in
		     this EAR — framework is inside each WAR, 3rd-party libs come from the
		     blade-shared shared library at runtime. -->
	</dependencies>

	<build>
		<finalName>blade-proto</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-ear-plugin</artifactId>
				<configuration>
					<version>8</version>
					<generateApplicationXml>true</generateApplicationXml>
					<displayName>BLADE Proto</displayName>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>ear-acl</id>
			<activation><property><name>!skip.acl</name></property></activation>
			<dependencies>
				<dependency>
					<groupId>org.vorpal.blade</groupId>
					<artifactId>vorpal-blade-services-acl</artifactId>
					<version>${project.version}</version>
					<type>war</type>
					<exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
				</dependency>
			</dependencies>
			<build><plugins><plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-ear-plugin</artifactId>
				<configuration>
					<modules combine.children="append">
						<webModule>
							<groupId>org.vorpal.blade</groupId>
							<artifactId>vorpal-blade-services-acl</artifactId>
							<contextRoot>acl</contextRoot>
							<bundleFileName>acl.war</bundleFileName>
						</webModule>
					</modules>
				</configuration>
			</plugin></plugins></build>
		</profile>
		<profile>
			<id>ear-balancer</id>
			<activation><property><name>!skip.balancer</name></property></activation>
			<dependencies>
				<dependency>
					<groupId>org.vorpal.blade</groupId>
					<artifactId>vorpal-blade-admin-balancer</artifactId>
					<version>${project.version}</version>
					<type>war</type>
					<exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
				</dependency>
			</dependencies>
			<build><plugins><plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-ear-plugin</artifactId>
				<configuration>
					<modules combine.children="append">
						<webModule>
							<groupId>org.vorpal.blade</groupId>
							<artifactId>vorpal-blade-admin-balancer</artifactId>
							<contextRoot>blade/balancer</contextRoot>
							<bundleFileName>blade-balancer.war</bundleFileName>
						</webModule>
					</modules>
				</configuration>
			</plugin></plugins></build>
		</profile>
		<profile>
			<id>ear-demo</id>
			<activation><property><name>!skip.demo</name></property></activation>
			<dependencies>
				<dependency>
					<groupId>org.vorpal.blade</groupId>
					<artifactId>vorpal-blade-demo</artifactId>
					<version>${project.version}</version>
					<type>war</type>
					<exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
				</dependency>
			</dependencies>
			<build><plugins><plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-ear-plugin</artifactId>
				<configuration>
					<modules combine.children="append">
						<webModule>
							<groupId>org.vorpal.blade</groupId>
							<artifactId>vorpal-blade-demo</artifactId>
							<contextRoot>blade/demo</contextRoot>
							<bundleFileName>blade-demo.war</bundleFileName>
						</webModule>
					</modules>
				</configuration>
			</plugin></plugins></build>
		</profile>
		<profile>
			<id>ear-player</id>
			<activation><property><name>!skip.player</name></property></activation>
			<dependencies>
				<dependency>
					<groupId>org.vorpal.blade</groupId>
					<artifactId>vorpal-blade-proto-player</artifactId>
					<version>${project.version}</version>
					<type>war</type>
					<exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
				</dependency>
			</dependencies>
			<build><plugins><plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-ear-plugin</artifactId>
				<configuration>
					<modules combine.children="append">
						<webModule>
							<groupId>org.vorpal.blade</groupId>
							<artifactId>vorpal-blade-proto-player</artifactId>
							<contextRoot>player</contextRoot>
							<bundleFileName>player.war</bundleFileName>
						</webModule>
					</modules>
				</configuration>
			</plugin></plugins></build>
		</profile>
		<profile>
			<id>ear-security</id>
			<activation><property><name>!skip.security</name></property></activation>
			<dependencies>
				<dependency>
					<groupId>org.vorpal.blade</groupId>
					<artifactId>vorpal-blade-admin-security</artifactId>
					<version>${project.version}</version>
					<type>war</type>
					<exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
				</dependency>
			</dependencies>
			<build><plugins><plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-ear-plugin</artifactId>
				<configuration>
					<modules combine.children="append">
						<webModule>
							<groupId>org.vorpal.blade</groupId>
							<artifactId>vorpal-blade-admin-security</artifactId>
							<contextRoot>blade/security</contextRoot>
							<bundleFileName>blade-security.war</bundleFileName>
						</webModule>
					</modules>
				</configuration>
			</plugin></plugins></build>
		</profile>
		<profile>
			<id>ear-test-console</id>
			<activation><property><name>!skip.test-console</name></property></activation>
			<dependencies>
				<dependency>
					<groupId>org.vorpal.blade</groupId>
					<artifactId>vorpal-blade-admin-test-console</artifactId>
					<version>${project.version}</version>
					<type>war</type>
					<exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
				</dependency>
			</dependencies>
			<build><plugins><plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-ear-plugin</artifactId>
				<configuration>
					<modules combine.children="append">
						<webModule>
							<groupId>org.vorpal.blade</groupId>
							<artifactId>vorpal-blade-admin-test-console</artifactId>
							<contextRoot>blade/test-console</contextRoot>
							<bundleFileName>blade-test.war</bundleFileName>
						</webModule>
					</modules>
				</configuration>
			</plugin></plugins></build>
		</profile>
	</profiles>

</project>
