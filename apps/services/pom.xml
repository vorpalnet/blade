	<artifactId>vorpal-blade-services-ear</artifactId>
	<packaging>ear</packaging>
	<name>BLADE Services EAR</name>
	<description>Single deployable that bundles every BLADE engine-tier service WAR, so the
		whole services tier can deploy to the cluster in one step. Each WAR is
		self-contained exactly as it deploys on its own — framework jar inside,
		blade-shared referenced via its own weblogic.xml — so the loose WARs in
		dist/services/ remain the per-service deploy path (visible individually in
		Remote Console); this EAR is a packaging convenience over them. Each
		service is contributed by its ear-&lt;name&gt; profile, activated by
		!skip.&lt;name&gt; — the same flags build.sh derives from the active build
		profile — so a trimmed profile yields an EAR of exactly that subset.</description>

	<dependencies>
		<!-- WAR modules are contributed via the ear-* profiles below. No JARs in
		     this EAR — framework is inside each WAR, 3rd-party libs come from the
		     blade-shared shared library at runtime. -->
	</dependencies>

	<build>
		<finalName>blade-services</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-ear-plugin</artifactId>
				<configuration>
					<version>8</version>
					<generateApplicationXml>true</generateApplicationXml>
					<displayName>BLADE Services</displayName>
				</configuration>
			</plugin>
		</plugins>
	</build>

