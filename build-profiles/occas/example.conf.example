# OCCAS silent install + dynamic-cluster domain config — EXAMPLE TEMPLATE.
# LEGACY REFERENCE. The installer is ./install.sh, which creates and edits its
# own profiles under .conf/<name>/ (gitignored) — start there, not here. An
# <env>.conf in this directory only feeds the standalone './certs.sh <env> …'
# form. Real env confs are gitignored — they carry your site's hostnames/IPs
# and must never be committed.
# Full walkthrough: build-profiles/occas/README.md
# Admin password lives in <env>.secret (gitignored), not here.

# ============================================================================
# Step -1 — prep (user, group, directories)
# ============================================================================
# install.sh's dashboard rows create install.user + inventory.group and the
# oracle.home / installer / inventory / java directories, owned so every
# later step runs without sudo.
# install.user=oracle

# ============================================================================
# Step 0 — download the media from Oracle eDelivery
# ============================================================================
# install.sh's download row fetches the installer media headlessly (curl); its
# install step auto-runs it when installer.jar is missing. One-time browser
# step per release (license click + wget.sh + access token) — the dashboard
# walks you through it and stashes the URLs as .conf/<name>/occas.urls;
# details in the README.
# download.dir=<dirname of installer.jar; falls back to /opt/oracle/media —
#               beside the install, where the install user can read it>

# --- Oracle JDK (official tarballs from download.oracle.com — no login) ---
# JDKs sit side by side under java.dir, and java.home is the
# <java.dir>/current SYMLINK — a Java upgrade is a flip of that one link,
# offered by install.sh's patch step. Shared location — NOT under a user home:
# the servers run as the oracle user, which can't traverse /home/<you>
# (mode 700).
java.dir=/opt/oracle/java
# java.home=/opt/oracle/java/current

# ============================================================================
# Step 1 — silent product install
# ============================================================================
# Where OCCAS gets installed (becomes $MW_HOME / ORACLE_HOME).
oracle.home=/opt/oracle/occas/8.3
# The OCCAS installer jar — always named occas_generic.jar. Keep it under a
# prep-created shared dir, NOT under a user home (mode-700 homes don't share).
# Override per-box without editing this: BLADE_OCCAS_INSTALLER=/path/occas_generic.jar
installer.jar=/opt/oracle/install/occas-8.3/occas_generic.jar
# Oracle central inventory (created on first install on this host).
inventory.loc=/opt/oracle/oraInventory
inventory.group=oinstall
install.type=Complete with Examples

# ============================================================================
# Step 2 — dynamic-cluster domain (occas-replicated-dynamiccluster.py)
# ============================================================================
# Domain name — by convention the SAME as the environment name (init enforces
# this). NOTE: configure writes with OverwriteDomain=true — pointing this at
# an EXISTING domain dir CLOBBERS it. Back up first.
domain.name=example
# 'prod' or 'dev'
server.start.mode=prod
admin.username=weblogic

# --- Dynamic cluster shape (BEA_ENGINE_TIER_CLUST) ---
# Generated servers are named <prefix>1, <prefix>2, … and auto-assigned to the
# machines listed in machine.match.expression (comma-separated names; machine0
# — the admin box — is deliberately NOT listed, so no engine lands on it).
server.name.prefix=engine
machine.match.expression=machine1,machine2
# MaximumDynamicServerCount — how many engine servers exist now.
dynamic.server.count=2
# MaxDynamicClusterSize — the growth ceiling.
max.dynamic.cluster.size=99

# --- Cluster firewall ---
# firewalld on OCI/OEL images allows only ssh, which blocks NodeManager (5556),
# t3 (7001), SIP, and coherence replication between the machines. install.sh's
# 'Open firewall ports' row (and engine provisioning) opens the NM/admin/ssl/sip
# ports on every box; firewall.trusted.source was the old installer's key and
# nothing reads it now.
# firewall.trusted.source=10.0.0.0/24

# --- Physical machines + their Node Managers ---
# CSV per machine: name:nmListenAddress:nmListenPort:nmType  (nmType = ssl|plain)
# machine0 = the admin box (NM-managed, but no engines). To ADD A NODE:
# install.sh's 'Add a machine' row grows the cluster online and provisions the
# host. Keep this list in sync anyway — certs.sh reads machine.N for the
# certificate SANs.
machine.1=machine0:10.0.0.11:5556:ssl
machine.2=machine1:10.0.0.12:5556:ssl
machine.3=machine2:10.0.0.13:5556:ssl

# --- Static test engine on the admin box (HISTORICAL) ---
# install.sh dropped static.server: engines follow the machines, so machine0
# runs engine0 from the same template as every other engine. Kept as a record
# of the pre-install.sh domain shape.
# Format: name:machine:listenPort:sipPort:sipsPort
static.server=engine0:machine0:8001:5060:5061

# --- TLS (steps: certs.sh + install.sh's HTTPS / SIP-TLS row) ---
# 1. ./certs.sh <env> generate      (test PKI)  — or 'import' for customer-issued
# 2. ./install.sh <profile> → the 'Turn on HTTPS / SIP-TLS' row (tls/make-certs.sh
#    + tls/install-ssl.sh) wires the keystores + SSL ports into AdminServer and
#    the engine template.
# Defaults shown; uncomment to override. store.password lives in <env>.secret.
# certs.dir=~/.blade/certs/<env>
# admin.ssl.port=7002
# ssl.listen.port=8002
# identity.keystore={certs.dir}/identity.p12
# trust.keystore={certs.dir}/trust.p12
# identity.alias=server
# tls.only=false
