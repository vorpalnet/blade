<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	id="WebApp_Audit" version="4.0">
	<display-name>blade-audit</display-name>

	<!--
	  Two gates, and they are not redundant. OidcLoginFilter establishes who the
	  caller is: a browser signed in with the deployment's OpenID Connect
	  provider when WEB-INF/blade-oidc.properties is present (deploy.sh adds it),
	  an API client with a bearer token, or, in a WAR deployed without the file,
	  the container's login named below. The application then asks
	  AccessEvaluator for phi:audit, which is the gate that actually decides:
	  being signed in grants no access to content, and the access log is content.

	  There is deliberately no auth-constraint. The container checks one before
	  any filter runs, so a constraint would demand its own login of every
	  browser and the OpenID sign-in could never start. (The earlier catch-all
	  deny on "/" also caught j_security_check and turned every login into a
	  403.) The filter is mapped to everything this WAR serves.
	-->
	<filter>
		<filter-name>OidcLoginFilter</filter-name>
		<filter-class>org.vorpal.blade.framework.v3.security.OidcLoginFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>OidcLoginFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<login-config>
		<auth-method>CLIENT-CERT,FORM</auth-method>
		<realm-name>default</realm-name>
		<form-login-config>
			<form-login-page>/login/login.jsp</form-login-page>
			<form-error-page>/login/login.jsp</form-error-page>
		</form-login-config>
	</login-config>

	<security-role><role-name>Admin</role-name></security-role>
	<security-role><role-name>Operator</role-name></security-role>
	<security-role><role-name>Deployer</role-name></security-role>
	<security-role><role-name>Monitor</role-name></security-role>
	<security-role><role-name>Reviewer</role-name></security-role>
</web-app>
