<?xml version="1.0" encoding="UTF-8"?>
<wls:weblogic-web-app xmlns:wls="http://xmlns.oracle.com/weblogic/weblogic-web-app" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd http://xmlns.oracle.com/weblogic/weblogic-web-app/1.9/weblogic-web-app.xsd">
	<wls:weblogic-version>14.1.2</wls:weblogic-version>
	<wls:context-root>blade/audit</wls:context-root>

	<wls:library-ref>
		<wls:library-name>blade-shared</wls:library-name>
		<wls:specification-version>3.0</wls:specification-version>
		<wls:exact-match>false</wls:exact-match>
	</wls:library-ref>

	<wls:session-descriptor>
		<wls:url-rewriting-enabled>false</wls:url-rewriting-enabled>
	</wls:session-descriptor>

	<!--
	  No security-role-assignment, deliberately. This application serves nothing:
	  it is a bus subscriber whose web.xml denies every URL. A role assignment here
	  would reference a role the deployment descriptor never declares, and
	  WebLogic refuses the deployment for exactly that:
	    HTTP:101168 The security-role-assignment references an invalid security-role: Admin
	  Reading the audit trail back is a separate, access-controlled surface behind
	  phi:audit, and whatever serves it declares its own roles.
	-->
</wls:weblogic-web-app>
