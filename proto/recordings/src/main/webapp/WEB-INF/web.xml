<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
	id="WebApp_ID" version="3.1">
	<display-name>blade-recordings</display-name>

	<!--
	  Two layers, and they answer different questions.

	  OidcLoginFilter answers "who is this person": a browser is signed in with
	  the deployment's OpenID Connect provider when WEB-INF/blade-oidc.properties
	  is present (deploy.sh adds it), an API client presents a bearer token, and
	  a WAR deployed without the file falls back to the container's login named
	  below. The application then answers "may this person hear THIS recording",
	  which no url-pattern can express, through AccessEvaluator. Being signed in
	  grants no access to content: a caller not named by a rule gets a 403.

	  There is deliberately no auth-constraint on the API. The container checks
	  one before any filter runs, so a constraint here would demand the
	  container's own login of every browser and the OpenID sign-in could never
	  start. The filter is mapped to everything this WAR serves; anything added
	  later is behind it too.
	-->
	<filter>
		<filter-name>OidcLoginFilter</filter-name>
		<filter-class>org.vorpal.blade.framework.v3.security.OidcLoginFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>OidcLoginFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<!-- The container's default JAX-RS base, denied to everyone. An empty
	     auth-constraint grants no role, so a resource that ever loses its
	     @ApplicationPath answers 403 instead of answering the world. -->
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>Default JAX-RS base - not the API</web-resource-name>
			<url-pattern>/resources/*</url-pattern>
		</web-resource-collection>
		<auth-constraint/>
	</security-constraint>

	<login-config>
		<auth-method>CLIENT-CERT,FORM</auth-method>
		<realm-name>default</realm-name>
		<form-login-config>
			<form-login-page>/login/login.jsp</form-login-page>
			<form-error-page>/login/login.jsp</form-error-page>
		</form-login-config>
	</login-config>
	<security-role><role-name>Admin</role-name></security-role>
	<security-role><role-name>Operator</role-name></security-role>
	<security-role><role-name>Deployer</role-name></security-role>
	<security-role><role-name>Monitor</role-name></security-role>
	<security-role><role-name>Reviewer</role-name></security-role>
</web-app>
