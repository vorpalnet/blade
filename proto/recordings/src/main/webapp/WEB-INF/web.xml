<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
	id="WebApp_ID" version="3.1">
	<display-name>blade-recordings</display-name>

	<!--
	  Two layers, and they answer different questions.

	  The container answers "may this person into the admin tier at all", in the
	  four platform roles, the same as every other admin app. The application
	  then answers "may this person hear THIS recording", which no url-pattern
	  can express, through AccessEvaluator. A platform role grants no access to
	  content: an Admin who is not named by a rule gets a 403 from the app.

	  The pattern matches RecordingsApplication's @ApplicationPath. Naming a
	  pattern nothing is served on is how services/context ended up serving its
	  whole API unauthenticated.
	-->
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>Recordings review</web-resource-name>
			<url-pattern>/api/*</url-pattern>
			<url-pattern>/</url-pattern>
		</web-resource-collection>
		<auth-constraint>
			<role-name>Admin</role-name>
			<role-name>Operator</role-name>
			<role-name>Deployer</role-name>
			<role-name>Monitor</role-name>
		</auth-constraint>
	</security-constraint>

	<!-- The container's default JAX-RS base, denied to everyone. An empty
	     auth-constraint grants no role, so a resource that ever loses its
	     @ApplicationPath answers 403 instead of answering the world. -->
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>Default JAX-RS base - not the API</web-resource-name>
			<url-pattern>/resources/*</url-pattern>
		</web-resource-collection>
		<auth-constraint/>
	</security-constraint>

	<login-config>
		<auth-method>CLIENT-CERT,FORM</auth-method>
		<realm-name>default</realm-name>
		<form-login-config>
			<form-login-page>/login/login.jsp</form-login-page>
			<form-error-page>/login/login.jsp</form-error-page>
		</form-login-config>
	</login-config>
	<security-role><role-name>Admin</role-name></security-role>
	<security-role><role-name>Operator</role-name></security-role>
	<security-role><role-name>Deployer</role-name></security-role>
	<security-role><role-name>Monitor</role-name></security-role>
</web-app>
