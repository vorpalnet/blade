<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.vorpal.blade</groupId>
		<artifactId>vorpal-blade</artifactId>
		<version>${revision}</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<artifactId>vorpal-blade-proto-listener</artifactId>
	<packaging>war</packaging>
	<name>BLADE Call Listener (proto)</name>
	<description>Records the calls the App Router routes through it. Each initial INVITE begins a new
		conversation with its own recording and its own classification; a re-INVITE that puts the call
		on hold pauses the recorder rather than ending the recording.</description>

	<build>
		<!-- A SIP servlet application is named for its context root: that is the
		     name the container reports to the App Router, and the name FSMAR
		     configs target. Do not prefix it. -->
		<finalName>listener</finalName>
	</build>

	<dependencies>
		<!-- Only the framework (skinny WAR). The JSR-309 API (com.oracle.occas:mscontrol, provided)
		     is inherited from the parent pom; the 309 driver is discovered at runtime via the SPI,
		     so there is no compile dependency on any media-server vendor. -->
		<dependency>
			<groupId>org.vorpal.blade</groupId>
			<artifactId>vorpal-blade-library-framework</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
