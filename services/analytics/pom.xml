<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.vorpal.blade</groupId>
		<artifactId>vorpal-blade</artifactId>
		<version>${revision}</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<artifactId>vorpal-blade-services-analytics</artifactId>
	<packaging>war</packaging>
	<name>BLADE Analytics Service</name>

	<dependencies>
		<dependency>
			<groupId>org.vorpal.blade</groupId>
			<artifactId>vorpal-blade-library-framework</artifactId>
		</dependency>

		<!-- Test scope only. The sink's wire-reading is pure and belongs under
		     test; everything else in it needs a live domain. Version managed in
		     the parent POM; nothing reaches WEB-INF/lib. -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- An in-memory database for the write path.

		     The insert-ordering bug compiled, passed every test, and failed on
		     the first live call — because nothing exercised a resolver, a
		     persist or a redelivery without a domain and a phone call.
		     AnalyticsWritePathTest does, in a plain JVM. -->
		<dependency>
			<groupId>org.hsqldb</groupId>
			<artifactId>hsqldb</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Lets AnalyticsWritePathTest target a real SQL Server when one is
		     reachable (BLADE_MSSQL_URL). Optional by design: the suite must run
		     offline in CI, so without that variable the test uses HSQLDB and
		     this driver is never loaded. -->
		<dependency>
			<groupId>com.microsoft.sqlserver</groupId>
			<artifactId>mssql-jdbc</artifactId>
			<version>12.8.1.jre11</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.persistence</groupId>
			<artifactId>org.eclipse.persistence.jpa</artifactId>
			<version>2.7.15</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>analytics</finalName>
	</build>

</project>
