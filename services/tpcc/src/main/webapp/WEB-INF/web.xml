<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	id="WebApp_ID" version="4.0"
>
	<display-name>3pcc</display-name>
	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
		<welcome-file>index.jsp</welcome-file>
		<welcome-file>index.htm</welcome-file>
		<welcome-file>default.html</welcome-file>
		<welcome-file>default.jsp</welcome-file>
		<welcome-file>default.htm</welcome-file>
	</welcome-file-list>

	<!--
	  Every method on the API needs a role. A constraint that lists methods and
	  carries no auth-constraint declares those URLs public, and this API
	  originates calls with any From and Request-URI the client sends: public, it
	  is toll fraud and caller-ID spoofing for anyone who reaches the engine's
	  HTTP port. No http-method list, so a verb nobody thought of is covered too.
	-->
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>API</web-resource-name>
			<url-pattern>/resources/*</url-pattern>
		</web-resource-collection>
		<auth-constraint>
			<role-name>Admin</role-name>
			<role-name>Operator</role-name>
		</auth-constraint>
	</security-constraint>

	<!-- Reads widen to any authenticated user; the roles of overlapping constraints are unioned. -->
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>API - reads</web-resource-name>
			<url-pattern>/resources/*</url-pattern>
			<http-method>GET</http-method>
			<http-method>HEAD</http-method>
		</web-resource-collection>
		<auth-constraint>
			<role-name>authenticated-users</role-name>
		</auth-constraint>
	</security-constraint>

	<!--
	  The OpenAPI document stays public: the API explorer on the AdminServer
	  probes it server to server, and it describes the API without exposing any
	  call. Exact-match patterns outrank /resources/*.
	-->
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>OpenAPI document</web-resource-name>
			<url-pattern>/resources/openapi.json</url-pattern>
			<url-pattern>/resources/openapi.yaml</url-pattern>
			<http-method>GET</http-method>
			<http-method>HEAD</http-method>
		</web-resource-collection>
	</security-constraint>

	<login-config>
		<auth-method>BASIC</auth-method>
		<realm-name>default</realm-name>
	</login-config>
	<security-role>
		<role-name>authenticated-users</role-name>
	</security-role>
	<security-role>
		<role-name>Admin</role-name>
	</security-role>
	<security-role>
		<role-name>Operator</role-name>
	</security-role>

</web-app>