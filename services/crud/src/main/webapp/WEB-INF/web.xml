<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	id="WebApp_ID" version="4.0">
	<display-name>crud</display-name>
	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
		<welcome-file>index.jsp</welcome-file>
		<welcome-file>index.htm</welcome-file>
		<welcome-file>default.html</welcome-file>
		<welcome-file>default.jsp</welcome-file>
		<welcome-file>default.htm</welcome-file>
	</welcome-file-list>

	<!--
	  This app has no HTTP API: no @Path class, no Application subclass. What
	  stood here were two constraints over /resources/api/*, /api/* and /v1/*,
	  copied from an app that did, and the first of them carried no
	  <auth-constraint>, which declares a path public rather than protecting it.
	  They guarded nothing and taught the wrong shape.

	  What remains is the guard: the container's default JAX-RS base, denied to
	  everyone. An empty <auth-constraint> grants no role, so the day someone
	  adds a @Path class here it answers 403 instead of answering the world.
	  Adding an API means adding an Application subclass with
	  @ApplicationPath("/api") and a constraint over /api/* — see
	  services/events and services/context.
	-->
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>Default JAX-RS base - no API here</web-resource-name>
			<url-pattern>/resources/*</url-pattern>
		</web-resource-collection>
		<auth-constraint/>
	</security-constraint>
	<login-config>
		<auth-method>BASIC</auth-method>
		<realm-name>default</realm-name>
	</login-config>
	<security-role>
		<role-name>authenticated-users</role-name>
	</security-role>
</web-app>
