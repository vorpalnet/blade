{
  "logging" : {
    "directory" : "./servers/${weblogic.Name}/logs/vorpal",
    "fileName" : "${sip.application.name}.%g.log",
    "loggingLevel" : "FINER",
    "sequenceDiagramLoggingLevel" : "FINE",
    "configurationLoggingLevel" : "INFO",
    "analyticsLoggingLevel" : "INFO",
    "snmpTrapLevel" : null,
    "fileSize" : "100MiB",
    "fileCount" : 25,
    "useParentLogging" : false,
    "appendFile" : true,
    "colorsEnabled" : false
  },
  "session" : {
    "expiration" : 60,
    "indexVorpalSessionID" : null,
    "keepAlive" : null,
    "sessionSelectors" : null,
    "passthru" : false
  },
  "pipeline" : [ {
    "type" : "sip",
    "id" : "sip",
    "description" : "Extract the dialed number from the To header",
    "selectors" : [ {
      "type" : "regex",
      "id" : "dialedNumber",
      "attribute" : "To",
      "pattern" : ".*<?sips?:\\+?(?<did>[^@;>]+)@.*",
      "expression" : "${did}"
    } ]
  }, {
    "type" : "table",
    "id" : "rule-selection",
    "description" : "Map the dialed number to a rule set",
    "tables" : [ {
      "match" : "hash",
      "keyExpression" : "${dialedNumber}",
      "translations" : {
        "8001" : {
          "ruleSet" : "example-create"
        },
        "8002" : {
          "ruleSet" : "example-read"
        },
        "8003" : {
          "ruleSet" : "example-update"
        },
        "8004" : {
          "ruleSet" : "example-delete"
        }
      }
    } ]
  } ],
  "defaultRuleSet" : "example-create",
  "ruleSets" : {
    "example-create" : {
      "id" : "example-create",
      "description" : "Stamp routing headers and attach recording metadata XML",
      "rules" : [ {
        "id" : "stamp-and-attach",
        "method" : "INVITE",
        "event" : "callStarted",
        "operations" : [ {
          "type" : "create",
          "attribute" : "X-Caller-Region",
          "value" : "us-west-2"
        }, {
          "type" : "create",
          "attribute" : "X-Trace-Id",
          "value" : "trace-${dialedNumber}"
        }, {
          "type" : "create",
          "attribute" : "body",
          "contentType" : "application/recording-metadata+xml",
          "value" : "<recording><session id=\"abc-123\" tenant=\"acme\"/></recording>"
        } ]
      } ]
    },
    "example-read" : {
      "id" : "example-read",
      "description" : "Capture values from headers, XML, JSON, and SDP into session variables",
      "rules" : [ {
        "id" : "harvest-everything",
        "method" : "INVITE",
        "event" : "callStarted",
        "operations" : [ {
          "type" : "read",
          "attribute" : "From",
          "pattern" : "sip:(?<callerUser>[^@]+)@(?<callerHost>[^;>]+)"
        }, {
          "type" : "xmlRead",
          "contentType" : "application/recording-metadata+xml",
          "expressions" : {
            "tenantId" : "//session/@tenant",
            "sessionId" : "//session/@id"
          }
        }, {
          "type" : "jsonRead",
          "contentType" : "application/json",
          "expressions" : {
            "agentId" : "$.agent.id"
          }
        }, {
          "type" : "sdpRead",
          "contentType" : "application/sdp",
          "expressions" : {
            "mediaAddr" : "$.connection.address",
            "mediaPort" : "$.media[0].port"
          }
        } ]
      } ]
    },
    "example-update" : {
      "id" : "example-update",
      "description" : "Anonymize the From header and rewrite values across XML, JSON, and SDP",
      "rules" : [ {
        "id" : "rewrite-everything",
        "method" : "INVITE",
        "event" : "callStarted",
        "operations" : [ {
          "type" : "update",
          "attribute" : "From",
          "pattern" : "sip:(?<u>[^@]+)@(?<h>[^;>]+)",
          "replacement" : "sip:anonymous@${h}"
        }, {
          "type" : "xmlUpdate",
          "contentType" : "application/recording-metadata+xml",
          "xpath" : "//session/@tenant",
          "value" : "redacted"
        }, {
          "type" : "jsonUpdate",
          "contentType" : "application/json",
          "jsonPath" : "$.agent.id",
          "value" : "MASKED"
        }, {
          "type" : "sdpUpdate",
          "contentType" : "application/sdp",
          "jsonPath" : "$.connection.address",
          "value" : "10.99.0.1"
        } ]
      } ]
    },
    "example-delete" : {
      "id" : "example-delete",
      "description" : "Strip private values across headers, XML, JSON, and SDP",
      "rules" : [ {
        "id" : "scrub-everything",
        "method" : "INVITE",
        "event" : "callStarted",
        "operations" : [ {
          "type" : "delete",
          "attribute" : "P-Asserted-Identity"
        }, {
          "type" : "xmlDelete",
          "contentType" : "application/recording-metadata+xml",
          "xpath" : "//session/@tenant"
        }, {
          "type" : "jsonDelete",
          "contentType" : "application/json",
          "jsonPath" : "$.agent.id"
        }, {
          "type" : "sdpDelete",
          "contentType" : "application/sdp",
          "jsonPath" : "$.media[0].attributes[?(@.name=='sendrecv')]"
        } ]
      } ]
    }
  },
  "version" : 0
}