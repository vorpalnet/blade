<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.vorpal.blade</groupId>
		<artifactId>vorpal-blade</artifactId>
		<version>${revision}</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<artifactId>vorpal-blade-admin-phone</artifactId>
	<packaging>war</packaging>
	<name>BLADE WebRTC Phone</name>
	<description>Browser softphone for the BLADE WebRTC gateway. It serves the UI and the
		client library, and every call is negotiated over a WebSocket to the webrtc service
		on the ENGINE tier. Nothing here talks to SIP or to a media server. Its only server
		side is identity: the page is behind the admin login, and it mints the short-lived
		signed token that carries the signed-in user — and the one address they may
		claim — across to a gateway on another host.</description>

	<dependencies>
		<!-- The framework JAR (SettingsManager, Configuration, JwtIssuer) is the
		     only compile dep; JAX-RS, Servlet and Jackson come from the blade-shared
		     shared library at runtime. Inherits the parent pom's packagingExcludes
		     regex, which bundles ONLY the framework JAR. -->
		<dependency>
			<groupId>org.vorpal.blade</groupId>
			<artifactId>vorpal-blade-library-framework</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>blade-phone</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<configuration>
					<!-- The login page is the portal master, injected at build time:
					     one source file, no per-app copies to drift. Edit
					     admin/portal/src/main/webapp/login.jsp, never add a per-app
					     login page. See SECURITY.md. -->
					<webResources>
						<resource>
							<directory>${project.basedir}/../portal/src/main/webapp</directory>
							<includes>
								<include>login.jsp</include>
							</includes>
							<targetPath>login</targetPath>
						</resource>
					</webResources>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
