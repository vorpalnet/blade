<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.vorpal.blade</groupId>
		<artifactId>vorpal-blade</artifactId>
		<version>${revision}</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<artifactId>vorpal-blade-admin-configurator</artifactId>
	<packaging>war</packaging>
	<name>BLADE Admin Configurator</name>

	<!-- Skinny WAR like every other admin/service app: WEB-INF/lib carries
	     only the framework jar (parent war-plugin packagingExcludes); all
	     3rd-party JARs come from the blade-shared shared library via the
	     <library-ref> in weblogic.xml. Common 3rd-party deps (jackson,
	     swagger, slf4j, ipaddress, json-path, commons-*) are inherited
	     provided-scope from the parent; only the Configurator-specific
	     extras are declared here. The exception is the Anthropic SDK, which
	     rides in this WAR's own WEB-INF/lib (see the packagingExcludes below). -->
	<dependencies>
		<!-- CredentialEncryption for {CLEARTEXT} → {AES} on save. -->
		<dependency>
			<groupId>org.vorpal.blade</groupId>
			<artifactId>vorpal-blade-library-framework</artifactId>
		</dependency>
		<dependency>
			<groupId>com.networknt</groupId>
			<artifactId>json-schema-validator</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- AI config assistant (AiConfigService). Bundled in this WAR, not in
		     blade-shared; OkHttp, Okio and kotlin-stdlib, which it also needs,
		     still come from blade-shared. -->
		<dependency>
			<groupId>com.anthropic</groupId>
			<artifactId>anthropic-java</artifactId>
		</dependency>
		<!-- Named so it stays on the compile class path: the SDK's runtime-scoped
		     Jackson dependencies would otherwise win Maven's mediation. -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.swagger.core.v3</groupId>
			<artifactId>swagger-jaxrs2-servlet-initializer-v2</artifactId>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>blade-configurator</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<configuration>
					<!-- Skinny-WAR exception: the Anthropic SDK and what it alone
					     needs ride here, not in blade-shared. Every JAR on a SIP
					     application's class path has all its classes loaded by the
					     container's annotation scan, so ~10,000 classes in the shared
					     library cost every SIP application on the engines for an API
					     only this admin application calls. -->
					<packagingExcludes>%regex[WEB-INF/lib/(?!vorpal-blade-library-framework|anthropic-java|kotlin-reflect|jackson-module-kotlin|jackson-datatype-jdk8|jsonschema-module-swagger-2|standardwebhooks|error_prone_annotations).*\.jar]</packagingExcludes>
					<!-- The login page is the portal master, injected at build time:
					     one source file, no per-app copies to drift. Edit
					     admin/portal/src/main/webapp/login.jsp, never add a per-app
					     login page. See SECURITY.md. -->
					<webResources>
						<resource>
							<directory>${project.basedir}/../portal/src/main/webapp</directory>
							<includes>
								<include>login.jsp</include>
							</includes>
						</resource>
					</webResources>
				</configuration>
			</plugin>
		</plugins>
	</build>


</project>
