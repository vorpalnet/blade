    "Rule" : {
      "type" : "object",
      "properties" : {
        "description" : {
          "type" : "string",
          "description" : "What this rule is for, in a sentence. Shown in the editor; no effect on calls.",
          "x-wide" : true
        },
        "enabled" : {
          "type" : "boolean",
          "description" : "False switches the rule off. A cluster or server file uses it to turn off a rule it inherits. Default true."
        },
        "method" : {
          "type" : "string",
          "description" : "SIP method filter. Single (INVITE), comma-OR (INVITE,REGISTER), or `!` to negate (!BYE). Null matches any method."
        },
        "messageType" : {
          "$ref" : "#/$defs/MessageType",
          "description" : "Message type filter: request or response. Null matches both."
        },
        "event" : {
          "type" : "string",
          "description" : "Lifecycle event filter. Same syntax as method: callStarted, callAnswered,callConnected, !callCompleted. Null matches all."
        },
        "leg" : {
          "$ref" : "#/$defs/Leg",
          "description" : "Only messages on this leg: caller or callee. Empty matches both."
        },
        "sdp" : {
          "$ref" : "#/$defs/SdpRole",
          "description" : "Only messages carrying an SDP offer, or an SDP answer (RFC 3264). Empty matches any message."
        },
        "statusRange" : {
          "type" : "string",
          "description" : "Status code filter for responses, e.g. 200, 200-299, 4xx, !5xx. Implicitly restricts to responses. Null matches any status."
        },
        "when" : {
          "type" : "string",
          "description" : "Boolean expression over session variables gating this rule, e.g. ${customerTier} == premium. Comparisons (== != < <= > >=), matches/contains/insubnet, and && || ! combinators. Null matches always; a malformed expression never matches.",
          "x-wide" : true
        },
        "resetVariables" : {
          "type" : "boolean",
          "description" : "Clear this rule's read variables from the session before running. Default false."
        },
        "operations" : {
          "description" : "Ordered list of operations: read / create / update / delete and the xml/json/sdp variants.",
