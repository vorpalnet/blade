{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$defs" : {
    "AddressMap" : {
      "type" : "object",
      "additionalProperties" : {
        "$ref" : "#/$defs/Translation-2"
      },
      "x-java-class" : "org.vorpal.blade.framework.v2.config.AddressMap"
    },
    "Analytics" : {
      "type" : "object",
      "properties" : {
        "enabled" : {
          "type" : "boolean",
          "description" : "Enable or disable analytics event collection",
          "default" : false
        },
        "events" : {
          "$ref" : "#/$defs/Map(String,EventSelector)",
          "description" : "Map of analytics event definitions keyed by event name"
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v2.analytics.Analytics"
    },
    "ApiKeyAuthentication-1" : {
      "type" : "object",
      "properties" : {
        "header" : {
          "type" : "string",
          "description" : "HTTP header name, e.g. X-API-Key"
        },
        "value" : {
          "type" : "string",
          "description" : "Header value; supports ${var}",
          "format" : "password"
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.auth.ApiKeyAuthentication"
    },
    "ApiKeyAuthentication-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.auth.ApiKeyAuthentication",
      "$ref" : "#/$defs/ApiKeyAuthentication-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "apikey"
        }
      },
      "required" : [ "type" ]
    },
    "AttributeSelector-1" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string",
          "description" : "Names the context variable this selector writes (${id}), and namespaces derived values such as regex groups (${id.group}). Optional, but a repeated id means whichever selector runs later overwrites the earlier value."
        },
        "attribute" : {
          "type" : "string",
          "description" : "What to extract: header name / JsonPath / XPath / SDP field / column / source attribute"
        },
        "allInstances" : {
          "type" : "boolean",
          "description" : "Read every instance of a repeating header (joined) so a condition tests any instance; default reads the first only"
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.selectors.AttributeSelector",
      "x-form-groups" : [ [ "id", "attribute" ] ]
    },
    "AttributeSelector-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.selectors.AttributeSelector",
      "x-form-groups" : [ [ "id", "attribute" ] ],
      "$ref" : "#/$defs/AttributeSelector-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "attribute"
        }
      }
    },
    "AttributeSelector-3" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string"
        },
        "description" : {
          "type" : "string"
        },
        "attribute" : {
          "type" : "string"
        },
        "pattern" : {
          "type" : "string",
          "description" : "Regular expression with named capturing groups for parsing the SIP attribute value"
        },
        "expression" : {
          "type" : "string"
        },
        "dialog" : {
          "$ref" : "#/$defs/DialogType"
        },
        "additionalExpressions" : {
          "$ref" : "#/$defs/Map(String,String)"
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v2.config.AttributeSelector"
    },
    "AwsSigV4Authentication-1" : {
      "type" : "object",
      "properties" : {
        "accessKeyId" : {
          "type" : "string",
          "description" : "AWS access key identifier; supports ${var}"
        },
        "secretAccessKey" : {
          "type" : "string",
          "description" : "AWS secret access key; supports ${var}",
          "format" : "password"
        },
        "region" : {
          "type" : "string",
          "description" : "AWS region, e.g. us-east-1; supports ${var}"
        },
        "service" : {
          "type" : "string",
          "description" : "AWS service name, e.g. execute-api, s3, lambda; supports ${var}"
        },
        "sessionToken" : {
          "type" : "string",
          "description" : "Optional STS session token (for temporary credentials); supports ${var}",
          "format" : "password"
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.auth.AwsSigV4Authentication"
    },
    "AwsSigV4Authentication-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.auth.AwsSigV4Authentication",
      "$ref" : "#/$defs/AwsSigV4Authentication-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "aws-sigv4"
        }
      },
      "required" : [ "type" ]
    },
    "BasicAuthentication-1" : {
      "type" : "object",
      "properties" : {
        "username" : {
          "type" : "string",
          "description" : "Username; supports ${var}"
        },
        "password" : {
          "type" : "string",
          "description" : "Password; supports ${var}",
          "format" : "password"
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.auth.BasicAuthentication"
    },
    "BasicAuthentication-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.auth.BasicAuthentication",
      "$ref" : "#/$defs/BasicAuthentication-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "basic"
        }
      },
      "required" : [ "type" ]
    },
    "BearerAuthentication-1" : {
      "type" : "object",
      "properties" : {
        "token" : {
          "type" : "string",
          "description" : "Bearer token for the Authorization header; supports ${var}",
          "format" : "password"
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.auth.BearerAuthentication"
    },
    "BearerAuthentication-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.auth.BearerAuthentication",
      "$ref" : "#/$defs/BearerAuthentication-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "bearer"
        }
      },
      "required" : [ "type" ]
    },
    "ConfigAddressMap-1" : {
      "type" : "object",
      "properties" : {
        "description" : {
          "type" : "string",
          "description" : "Description of this translation map's purpose"
        },
        "id" : {
          "type" : "string",
          "description" : "Unique identifier for this translation map"
        },
        "map" : {
          "$ref" : "#/$defs/AddressMap",
          "description" : "IP address map for CIDR-based routing lookups"
        },
        "selectors" : {
          "description" : "Selectors that extract lookup keys from SIP messages",
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Selector"
          }
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v2.config.ConfigAddressMap"
    },
    "ConfigAddressMap-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v2.config.ConfigAddressMap",
      "$ref" : "#/$defs/ConfigAddressMap-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "address"
        }
      },
      "required" : [ "type" ]
    },
    "ConfigHashMap-1" : {
      "type" : "object",
      "properties" : {
        "description" : {
          "type" : "string",
          "description" : "Description of this translation map's purpose"
        },
        "id" : {
          "type" : "string",
          "description" : "Unique identifier for this translation map"
        },
        "map" : {
          "$ref" : "#/$defs/HashMap(String,Translation)",
          "description" : "Hash map of translation entries keyed by lookup value"
        },
        "selectors" : {
          "description" : "Selectors that extract lookup keys from SIP messages",
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Selector"
          }
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v2.config.ConfigHashMap"
    },
    "ConfigHashMap-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v2.config.ConfigHashMap",
      "$ref" : "#/$defs/ConfigHashMap-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "hash"
        }
      },
      "required" : [ "type" ]
    },
    "ConfigLinkedHashMap-1" : {
      "type" : "object",
      "properties" : {
        "description" : {
          "type" : "string",
          "description" : "Description of this translation map's purpose"
        },
        "id" : {
          "type" : "string",
          "description" : "Unique identifier for this translation map"
        },
        "map" : {
          "$ref" : "#/$defs/LinkedHashMap(String,Translation)",
          "description" : "Ordered map of translation entries keyed by lookup value"
        },
        "selectors" : {
          "description" : "Selectors that extract lookup keys from SIP messages",
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Selector"
          }
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v2.config.ConfigLinkedHashMap"
    },
    "ConfigLinkedHashMap-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v2.config.ConfigLinkedHashMap",
      "$ref" : "#/$defs/ConfigLinkedHashMap-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "linked"
        }
      },
      "required" : [ "type" ]
    },
    "ConfigPrefixMap-1" : {
      "type" : "object",
      "properties" : {
        "description" : {
          "type" : "string",
          "description" : "Description of this translation map's purpose"
        },
        "id" : {
          "type" : "string",
          "description" : "Unique identifier for this translation map"
        },
        "map" : {
          "$ref" : "#/$defs/HashMap(String,Translation)",
          "description" : "Prefix-matching map of translation entries for longest-prefix lookups"
        },
        "selectors" : {
          "description" : "Selectors that extract lookup keys from SIP messages",
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Selector"
          }
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v2.config.ConfigPrefixMap"
    },
    "ConfigPrefixMap-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v2.config.ConfigPrefixMap",
      "$ref" : "#/$defs/ConfigPrefixMap-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "prefix"
        }
      },
      "required" : [ "type" ]
    },
    "ConfigTreeMap-1" : {
      "type" : "object",
      "properties" : {
        "description" : {
          "type" : "string",
          "description" : "Description of this translation map's purpose"
        },
        "id" : {
          "type" : "string",
          "description" : "Unique identifier for this translation map"
        },
        "map" : {
          "$ref" : "#/$defs/TreeMap(String,Translation)",
          "description" : "Sorted map of translation entries keyed by lookup value"
        },
        "selectors" : {
          "description" : "Selectors that extract lookup keys from SIP messages",
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/Selector"
          }
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v2.config.ConfigTreeMap"
    },
    "ConfigTreeMap-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v2.config.ConfigTreeMap",
      "$ref" : "#/$defs/ConfigTreeMap-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "tree"
        }
      },
      "required" : [ "type" ]
    },
    "Connector" : {
      "anyOf" : [ {
        "$ref" : "#/$defs/SipConnector-2"
      }, {
        "$ref" : "#/$defs/RestConnector-2"
      }, {
        "$ref" : "#/$defs/JdbcConnector-2"
      }, {
        "$ref" : "#/$defs/LdapConnector-2"
      }, {
        "$ref" : "#/$defs/TableConnector-2"
      }, {
        "$ref" : "#/$defs/RateConnector-2"
      } ],
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.connectors.Connector"
    },
    "CreateOperation-1" : {
      "type" : "object",
      "properties" : {
        "attribute" : {
          "type" : "string",
          "description" : "SIP attribute to create — header name, Request-URI, or body."
        },
        "contentType" : {
          "type" : "string",
          "description" : "Optional MIME content type when creating a specific part of a multipart body."
        },
        "value" : {
          "type" : "string",
          "description" : "Value to set. Supports ${variable} substitution, e.g. \"${user}@${host}\"",
          "format" : "textarea",
          "x-wide" : true
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v3.crud.CreateOperation"
    },
    "CreateOperation-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v3.crud.CreateOperation",
      "$ref" : "#/$defs/CreateOperation-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "create"
        }
      },
      "required" : [ "type" ]
    },
    "Crud" : {
      "type" : "object",
      "properties" : {
        "variables" : {
          "$ref" : "#/$defs/Map(String,String)",
          "description" : "Named values every call starts with, read as `${name}` by the pipeline, `when` and operations. A cluster or server file sets its own by naming them."
        },
        "pipeline" : {
          "$ref" : "#/$defs/Map(String,Connector)",
          "description" : "Enrichment connectors by id, run in order once on the call's initial request; may write the `ruleSet` variable to select a rule set. Usually empty."
        },
        "defaultRuleSet" : {
          "type" : "string",
          "description" : "Rule set applied when the pipeline selects none. With no pipeline, the rule set every call gets."
        },
        "ruleSets" : {
          "$ref" : "#/$defs/Map(String,RuleSet)",
          "description" : "Named rule sets, keyed by id. Rules run on each message the application sends; filter them by method and `when`, not by event."
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v3.crud.Crud"
    },
    "DeleteOperation-1" : {
      "type" : "object",
      "properties" : {
        "attribute" : {
          "type" : "string",
          "description" : "SIP attribute to delete — header name, or `body` to clear the body."
        },
        "contentType" : {
          "type" : "string",
          "description" : "Optional MIME content type to remove just one part of a multipart body."
        },
        "pattern" : {
          "type" : "string",
          "description" : "Optional regex: remove only the occurrences of the header it matches. Empty removes every occurrence."
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v3.crud.DeleteOperation"
    },
    "DeleteOperation-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v3.crud.DeleteOperation",
      "$ref" : "#/$defs/DeleteOperation-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "delete"
        }
      },
      "required" : [ "type" ]
    },
    "DialogType" : {
      "type" : "string",
      "enum" : [ "origin", "destination" ],
      "x-java-class" : "org.vorpal.blade.framework.v2.config.AttributeSelector$DialogType"
    },
    "EventBusSettings" : {
      "type" : "object",
      "properties" : {
        "enabled" : {
          "type" : "boolean",
          "description" : "Whether this application publishes to the event bus, including the call lifecycle events the framework emits. Leave unset to publish only when the domain's JMS bus is provisioned and say nothing when it is not; true to require it (an unreachable bus is then an error); false to never publish."
        },
        "connectionFactoryJndi" : {
          "type" : "string",
          "description" : "JNDI name of the connection factory the bus publishes through. Defaults to the framework constant; set it only on a domain provisioned under different names."
        },
        "destinationJndi" : {
          "type" : "string",
          "description" : "JNDI name of the destination this application publishes to. Defaults to the framework constant."
        },
        "providerUrl" : {
          "type" : "string",
          "description" : "Where the bus's JNDI names are looked up, when not in this server's own tree: a provider URL on the engine cluster, e.g. t3://engine0.example:8001 (several comma-separated). Leave empty: an engine finds the bus in its own tree, and an application on the AdminServer finds the running engines that host it by itself. Set it only to override that."
        },
        "source" : {
          "type" : "string",
          "description" : "CloudEvents 'source' stamped on events this application publishes. Leave empty to derive it from the application name."
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v3.events.EventBusSettings"
    },
    "EventSelector" : {
      "type" : "object",
      "properties" : {
        "attributes" : {
          "description" : "Set of attribute selectors that extract data from SIP messages for this event",
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/AttributeSelector-3"
          }
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v2.analytics.EventSelector"
    },
    "HashMap(String,Translation)" : {
      "type" : "object",
      "additionalProperties" : {
        "$ref" : "#/$defs/Translation-2"
      }
    },
    "HmacAuthentication-1" : {
      "type" : "object",
      "properties" : {
        "algorithm" : {
          "type" : "string",
          "description" : "HMAC algorithm: sha1, sha256 (default), or sha512"
        },
        "secret" : {
          "type" : "string",
          "description" : "Shared secret; supports ${var}",
          "format" : "password"
        },
        "header" : {
          "type" : "string",
          "description" : "Header name to stamp with the signature (e.g. X-Signature); supports ${var}"
        },
        "payloadTemplate" : {
          "type" : "string",
          "description" : "Template of what to sign; ${var} resolved first, then ${method}/${url}/${body} substituted. Default: ${body}"
        },
        "encoding" : {
          "type" : "string",
          "description" : "Output encoding: hex (default, lowercase) or base64"
        },
        "prefix" : {
          "type" : "string",
          "description" : "Optional prefix prepended to the encoded signature, e.g. \"sha256=\" for GitHub; supports ${var}"
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.auth.HmacAuthentication"
    },
    "HmacAuthentication-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.auth.HmacAuthentication",
      "$ref" : "#/$defs/HmacAuthentication-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "hmac"
        }
      },
      "required" : [ "type" ]
    },
    "IdentitySelector-1" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string",
          "description" : "Names the context variable this selector writes (${id}), and namespaces derived values such as regex groups (${id.group}). Optional, but a repeated id means whichever selector runs later overwrites the earlier value."
        },
        "attribute" : {
          "type" : "string",
          "description" : "What to extract: header name / JsonPath / XPath / SDP field / column / source attribute"
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.selectors.IdentitySelector"
    },
    "IdentitySelector-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.selectors.IdentitySelector",
      "$ref" : "#/$defs/IdentitySelector-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "identity"
        }
      },
      "required" : [ "type" ]
    },
    "JdbcConnector-1" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string",
          "description" : "Label for this connector in log and trap messages, e.g. RestConnector[screening]. Optional, and not required to be unique."
        },
        "description" : {
          "type" : "string",
          "description" : "Human-readable description of what this connector does",
          "x-wide" : true
        },
        "dataSource" : {
          "type" : "string",
          "description" : "JNDI name of the WebLogic JDBC DataSource, e.g. jdbc/CustomerDS"
        },
        "queryTemplate" : {
          "type" : "string",
          "description" : "SQL template filename in _templates/ (supports ${var})"
        },
        "queryTimeoutSeconds" : {
          "type" : "integer",
          "description" : "Seconds a query may run before the driver cancels it and the call continues to its default route. Default 5; 0 waits forever."
        },
        "circuitBreakerCooldownSeconds" : {
          "type" : "integer",
          "description" : "Circuit breaker: after a failed query (datasource down, connection or SQL error), suppress further queries for N seconds and let routing fall to its default route. Prevents hammering a down database and stops every call from eating the connection timeout during an outage. 0 or empty disables it (default)."
        },
        "circuitBreakerTrap" : {
          "type" : "boolean",
          "description" : "When the circuit breaker opens or recovers, emit one SNMP trap on each edge (down, then up). Requires the WebLogic SNMP agent enabled with a trap destination (see the Tuning app). Default false."
        },
        "selectors" : {
          "description" : "Selectors that parse this connector's payload and write to the session",
          "type" : "array",
          "items" : {
            "anyOf" : [ {
              "$ref" : "#/$defs/AttributeSelector-2"
            }, {
              "$ref" : "#/$defs/JsonSelector-2"
            }, {
              "$ref" : "#/$defs/XmlSelector-2"
            }, {
              "$ref" : "#/$defs/SdpSelector-2"
            }, {
              "$ref" : "#/$defs/RegexSelector-2"
            }, {
              "$ref" : "#/$defs/TableSelector-2"
            }, {
              "$ref" : "#/$defs/IdentitySelector-2"
            } ]
          }
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.connectors.JdbcConnector"
    },
    "JdbcConnector-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.connectors.JdbcConnector",
      "$ref" : "#/$defs/JdbcConnector-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "jdbc"
        }
      },
      "required" : [ "type" ]
    },
    "JsonPathCreateOperation-1" : {
      "type" : "object",
      "properties" : {
        "contentType" : {
          "type" : "string",
          "description" : "Content type of the JSON MIME part to target, e.g. application/json. Null targets the entire body."
        },
        "key" : {
          "type" : "string",
          "description" : "Property key to add when the parent is an object. Leave null to append to an array parent."
        },
        "parentPath" : {
          "type" : "string",
          "description" : "JsonPath of the parent object or array, e.g. $.agent",
          "x-wide" : true
        },
        "value" : {
          "type" : "string",
          "description" : "Value to add. Supports ${variable} substitution."
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v3.crud.JsonPathCreateOperation"
    },
    "JsonPathCreateOperation-2" : {
      "x-java-class" : "org.vorpal.blade.framework.v3.crud.JsonPathCreateOperation",
      "$ref" : "#/$defs/JsonPathCreateOperation-1",
      "type" : "object",
      "properties" : {
        "type" : {
