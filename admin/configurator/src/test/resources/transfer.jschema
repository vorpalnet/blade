  "type" : "object",
  "properties" : {
    "version" : {
      "type" : "integer",
      "description" : "Config schema version (framework-managed)",
      "x-readonly" : true
    },
    "notes" : {
      "type" : "string",
      "description" : "Free-form notes about this configuration",
      "format" : "textarea",
      "x-wide" : true
    },
    "logging" : {
      "$ref" : "#/$defs/LogParameters",
      "description" : "Logging parameters"
    },
    "session" : {
      "$ref" : "#/$defs/SessionParameters",
      "description" : "Session parameters"
    },
    "analytics" : {
      "$ref" : "#/$defs/Analytics",
      "description" : "Analytics parameters"
    },
    "events" : {
      "$ref" : "#/$defs/EventBusSettings",
      "description" : "Event bus parameters — whether this application publishes CloudEvents, and to which destination"
    },
    "allow" : {
      "type" : "string",
      "description" : "Comma-separated list of allowed SIP methods for transfer operations"
    },
    "allowCallerRefer" : {
      "type" : "boolean",
      "description" : "Allow a REFER from the caller's leg to start a transfer. Default false: only the callee (contact-center) leg may transfer, since a caller-side REFER can name any destination.",
      "default" : false
    },
    "crud" : {
      "$ref" : "#/$defs/Crud",
      "description" : "CRUD rules run on every message the transfer service sends, such as the INVITE to a transfer target"
    },
    "defaultRoute" : {
      "$ref" : "#/$defs/Translation-2",
      "description" : "Default route used when no translation map matches"
    },
    "defaultTransferStyle" : {
      "$ref" : "#/$defs/TransferStyle",
      "description" : "Default transfer method: blind, attended, conference, or refer",
      "default" : "attended"
    },
    "defaultWebhook" : {
      "type" : "string",
      "description" : "The webhook that gets the events of every transfer no REST request named one for, such as a REFER's; none when unset"
    },
    "maps" : {
      "description" : "Translation maps used for routing lookups and address resolution",
      "type" : "array",
      "items" : {
        "anyOf" : [ {
          "$ref" : "#/$defs/ConfigAddressMap-2"
        }, {
          "$ref" : "#/$defs/ConfigPrefixMap-2"
        }, {
          "$ref" : "#/$defs/ConfigHashMap-2"
        }, {
          "$ref" : "#/$defs/ConfigLinkedHashMap-2"
        }, {
          "$ref" : "#/$defs/ConfigTreeMap-2"
        } ]
      }
    },
    "plan" : {
      "description" : "Ordered routing plan that defines the sequence of translation map lookups",
      "type" : "array",
      "items" : {
        "anyOf" : [ {
          "$ref" : "#/$defs/ConfigAddressMap-2"
        }, {
          "$ref" : "#/$defs/ConfigPrefixMap-2"
        }, {
          "$ref" : "#/$defs/ConfigHashMap-2"
        }, {
          "$ref" : "#/$defs/ConfigLinkedHashMap-2"
        }, {
          "$ref" : "#/$defs/ConfigTreeMap-2"
        } ]
      }
    },
    "preserveInviteHeaders" : {
      "description" : "List of SIP header names to preserve when forwarding INVITE requests during transfer",
      "type" : "array",
      "items" : {
        "type" : "string"
      }
    },
    "preserveReferHeaders" : {
      "description" : "List of SIP header names to preserve when forwarding REFER requests during transfer",
      "type" : "array",
      "items" : {
        "type" : "string"
      }
    },
    "selectors" : {
      "description" : "List of selectors that extract values from SIP messages for routing lookups",
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/Selector"
      }
    },
    "transferAllRequests" : {
      "type" : "boolean",
      "description" : "When true, all requests are eligible for transfer, not just INVITE",
      "default" : false
    },
    "webhooks" : {
      "$ref" : "#/$defs/Map(String,Webhook)",
      "description" : "Web services transfer events are POSTed to, by name. A REST request picks one with notification.style 'callback' and notification.callbackName"
    }
  },
  "x-java-class" : "org.vorpal.blade.framework.v3.transfer.TransferSettings",
  "title" : "Transfer",
  "x-tagline" : "Attended & Blind Call Transfer",
  "description" : "Implements SIP call transfer (RFC 3515 REFER) for both attended (consultative) and blind transfers, managing the REFER/NOTIFY signaling and transfer state through completion or failure."
}