      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string",
          "description" : "Label for this connector in log and trap messages, e.g. RestConnector[screening]. Optional, and not required to be unique."
        },
        "description" : {
          "type" : "string",
          "description" : "Human-readable description of what this connector does",
          "x-wide" : true
        },
        "ldapUrl" : {
          "type" : "string",
          "description" : "LDAP server URL, e.g. ldap://ad.corp.example.com:389"
        },
        "bindDn" : {
          "type" : "string",
          "description" : "Bind DN for the service account"
        },
        "bindPassword" : {
          "type" : "string",
          "description" : "Bind password",
          "format" : "password"
        },
        "searchTemplate" : {
          "type" : "string",
          "description" : "Search template filename in _templates/"
        },
        "circuitBreakerCooldownSeconds" : {
          "type" : "integer",
          "description" : "Circuit breaker: after a failed search (directory down, bind or connection error), suppress further searches for N seconds and let routing fall to its default route. Prevents hammering a down directory and stops every call from eating the LDAP timeout during an outage. 0 or empty disables it (default)."
        },
        "circuitBreakerTrap" : {
          "type" : "boolean",
          "description" : "When the circuit breaker opens or recovers, emit one SNMP trap on each edge (down, then up). Requires the WebLogic SNMP agent enabled with a trap destination (see the Tuning app). Default false."
        },
        "selectors" : {
          "description" : "Selectors that parse this connector's payload and write to the session",
          "type" : "array",
          "items" : {
            "anyOf" : [ {
              "$ref" : "#/$defs/AttributeSelector-2"
            }, {
              "$ref" : "#/$defs/JsonSelector-2"
            }, {
              "$ref" : "#/$defs/XmlSelector-2"
            }, {
              "$ref" : "#/$defs/SdpSelector-2"
            }, {
              "$ref" : "#/$defs/RegexSelector-2"
            }, {
              "$ref" : "#/$defs/TableSelector-2"
            }, {
              "$ref" : "#/$defs/IdentitySelector-2"
            } ]
          }
        }
      },
      "x-java-class" : "org.vorpal.blade.framework.v3.configuration.connectors.LdapConnector"
    },
