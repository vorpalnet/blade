    "LogParameters" : {
      "type" : "object",
      "properties" : {
        "directory" : {
          "type" : "string",
          "description" : "Location of log files. Supports environment and servlet context variables. Default: ./servers/${weblogic.Name}/logs/vorpal",
          "default" : "./servers/${weblogic.Name}/logs/vorpal"
        },
        "fileName" : {
          "type" : "string",
          "description" : "Name of the log file. Supports environment and servlet context variables. Default: ${sip.application.name}.%g.log",
          "default" : "${sip.application.name}.%g.log"
        },
        "loggingLevel" : {
          "$ref" : "#/$defs/LoggingLevel",
          "description" : "Logging level. Levels include: OFF, SEVERE, WARNING, INFO, CONFIG, FINE, FINER, FINEST, ALL. Default: INFO",
          "default" : "INFO"
        },
        "sequenceDiagramLoggingLevel" : {
          "$ref" : "#/$defs/LoggingLevel",
          "description" : "Level at which sequence diagrams will be logged. Default: FINE",
          "default" : "FINE"
        },
        "configurationLoggingLevel" : {
          "$ref" : "#/$defs/LoggingLevel",
          "description" : "Level at which configuration changes will be logged. Default: INFO",
          "default" : "INFO"
        },
        "analyticsLoggingLevel" : {
          "$ref" : "#/$defs/LoggingLevel",
          "description" : "Level at which analytics (if enabled) will be logged. Default: INFO",
          "default" : "INFO"
        },
        "snmpTrapLevel" : {
          "$ref" : "#/$defs/LoggingLevel",
          "description" : "Emit an SNMP trap for any log statement at or above this level (OFF disables). Requires the WebLogic SNMP agent to be enabled with a trap destination (see the Tuning app). Default: OFF",
          "default" : "OFF"
        },
        "fileSize" : {
          "type" : "string",
          "description" : "Maximum file size written in human readable form. Default: 100MiB",
          "default" : "100MiB"
        },
        "fileCount" : {
          "type" : "integer",
          "description" : "Maximum number of log files. Default: 25",
          "default" : 25
        },
        "useParentLogging" : {
          "type" : "boolean",
          "description" : "Write to parent logger, i.e. the WebLogic engine log file. Default: false",
          "default" : false
        },
        "appendFile" : {
          "type" : "boolean",
          "description" : "Continue to use the same log file after reboot. Default: true",
          "default" : true
        },
        "colorsEnabled" : {
          "type" : "boolean",
          "description" : "Support ANSI colors in logging?",
          "default" : false
        }
      },
      "required" : [ "directory", "fileName", "loggingLevel", "sequenceDiagramLoggingLevel", "configurationLoggingLevel", "analyticsLoggingLevel", "snmpTrapLevel", "fileSize", "fileCount", "useParentLogging", "appendFile", "colorsEnabled" ],
      "x-java-class" : "org.vorpal.blade.framework.v2.logging.LogParameters",
      "x-form-groups" : [ [ "directory", "fileName" ], [ "loggingLevel", "sequenceDiagramLoggingLevel", "configurationLoggingLevel", "analyticsLoggingLevel", "snmpTrapLevel" ] ],
      "x-form-columns" : [ {
        "columns" : [ [ "fileSize", "fileCount" ], [ "useParentLogging", "appendFile", "colorsEnabled" ] ]
      } ]
    },
