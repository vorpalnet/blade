	<!-- No <taglib> entries: the JSTL tags come from the blade-shared library,
	     whose taglibs-standard-impl JAR declares its own URIs. A taglib-location
	     naming /WEB-INF/lib/taglibs-standard-impl-*.jar points at a JAR the
	     skinny WAR strips, and the login page then fails to compile. -->
	<jsp-config>
		<jsp-property-group>
			<url-pattern>*.jsp</url-pattern>
			<page-encoding>UTF-8</page-encoding>
		</jsp-property-group>
	</jsp-config>
	
	

	<!-- no security required -->
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>login</web-resource-name>
			<url-pattern>/login.jsp</url-pattern>
			<url-pattern>/denied.jsp</url-pattern>
		</web-resource-collection>
	</security-constraint>
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>assets</web-resource-name>
			<url-pattern>/assets/*</url-pattern>
		</web-resource-collection>
	</security-constraint>

	<!-- REST API: no container auth. Carved out of the FORM constraint below
	     (more-specific pattern wins) so CLI clients can authenticate with an
	     HTTP Basic Authorization header instead of j_security_check. The
	     credentials are validated by BasicAuthFilter, which checks the same
	     realm and admin roles the FORM constraint would. The browser app keeps
	     FORM login. -->
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>api</web-resource-name>
			<url-pattern>/api/v1/*</url-pattern>
		</web-resource-collection>
	</security-constraint>


	<security-constraint>
		<web-resource-collection>
			<web-resource-name>blade</web-resource-name>
			<url-pattern>/</url-pattern>
		</web-resource-collection>
		<auth-constraint>
			<role-name>Admin</role-name>
			<role-name>Operator</role-name>
			<role-name>Deployer</role-name>
			<role-name>Monitor</role-name>
		</auth-constraint>
	</security-constraint>

	<!-- A person signed in without a role that opens this application gets
	     the master page naming the roles that do (admin/portal/denied.jsp). -->
	<error-page>
		<error-code>403</error-code>
		<location>/denied.jsp</location>
	</error-page>

	<login-config>
		<auth-method>CLIENT-CERT,FORM</auth-method>
		<realm-name>default</realm-name>
		<form-login-config>
			<form-login-page>/login.jsp</form-login-page>
			<form-error-page>/login.jsp</form-error-page>
		</form-login-config>
	</login-config>

	<security-role>
		<role-name>Admin</role-name>
	</security-role>

	<security-role>
		<role-name>Operator</role-name>
	</security-role>

	<security-role>
		<role-name>Deployer</role-name>
	</security-role>

	<security-role>
		<role-name>Monitor</role-name>
	</security-role>


</web-app>
