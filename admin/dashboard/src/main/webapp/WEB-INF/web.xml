<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	id="WebApp_Dashboard" version="4.0">

	<!-- display-name → JMX MBean key and the on-disk config file name. -->
	<display-name>dashboard</display-name>

	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
	</welcome-file-list>

	<!--
	  Who is asking: OidcLoginFilter signs the browser in with the deployment's
	  OpenID Connect provider when WEB-INF/blade-oidc.properties is present
	  (deploy.sh adds it), so a tenant's people need no WebLogic account; a WAR
	  deployed without the file falls back to the container's login named below.
	  What they may see: the dashboard's grants, by group (Access). With no
	  grants configured, only the WebLogic admin roles see anything.
	  There is deliberately no auth-constraint. The container checks one before
	  any filter runs, so a constraint would demand the container's own login of
	  every browser and the OpenID sign-in could never start. The container's
	  login form stays public: it must answer before anyone is signed in.
	-->
	<filter>
		<filter-name>OidcLoginFilter</filter-name>
		<filter-class>org.vorpal.blade.framework.v3.security.OidcLoginFilter</filter-class>
		<init-param>
			<param-name>publicPaths</param-name>
			<param-value>/login/*</param-value>
		</init-param>
	</filter>
	<filter-mapping>
		<filter-name>OidcLoginFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<login-config>
		<auth-method>CLIENT-CERT,FORM</auth-method>
		<realm-name>default</realm-name>
		<form-login-config>
			<form-login-page>/login/login.jsp</form-login-page>
			<form-error-page>/login/login.jsp</form-error-page>
		</form-login-config>
	</login-config>

	<security-role><role-name>Admin</role-name></security-role>
	<security-role><role-name>Operator</role-name></security-role>
	<security-role><role-name>Deployer</role-name></security-role>
	<security-role><role-name>Monitor</role-name></security-role>

</web-app>
