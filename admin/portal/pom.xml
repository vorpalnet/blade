<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.vorpal.blade</groupId>
		<artifactId>vorpal-blade</artifactId>
		<version>${revision}</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<artifactId>vorpal-blade-admin-portal</artifactId>
	<packaging>war</packaging>
	<name>BLADE Admin Portal</name>
	<description>
		Unified admin shell. Launcher deck for every admin app on this
		AdminServer, built live from JMX — WebApplicationRuntime MBeans
		for deployed blade/* webapps, Configuration MBeans for services
		with a SchemaAbout identity. No manifest; an app that registers
		a SettingsMXBean appears with no portal redeploy. Also owns the
		master login.jsp and the /brand assets the other admin WARs use.
	</description>

	<dependencies>
		<dependency>
			<groupId>org.vorpal.blade</groupId>
			<artifactId>vorpal-blade-library-framework</artifactId>
		</dependency>
	</dependencies>

	<build>
		<finalName>blade-portal</finalName>
		<!-- Inherits the parent pom's maven-war-plugin packagingExcludes regex,
		     which excludes every JAR EXCEPT vorpal-blade-library-framework.
		     Portal's Java (PortalStartupListener) instantiates SettingsManager
		     from that JAR, so it must be bundled into the WAR — the shared
		     library holds only 3rd-party JARs and does NOT contain the
		     framework JAR. -->
	</build>

</project>
