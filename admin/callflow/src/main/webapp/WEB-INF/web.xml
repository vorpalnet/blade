<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	id="WebApp_Callflow" version="4.0">

	<display-name>callflow</display-name>

	<welcome-file-list>
		<welcome-file>traces.html</welcome-file>
	</welcome-file-list>

	<!-- Registers the SettingsManager so the app's name/tagline appear on the
	     Admin Portal launcher deck. -->
	<listener>
		<listener-class>org.vorpal.blade.applications.callflow.CallflowStartup</listener-class>
	</listener>

	<!--
	  Who is asking: OidcLoginFilter signs the browser in with the deployment's
	  OpenID Connect provider when WEB-INF/blade-oidc.properties is present
	  (deploy.sh adds it), so a tenant's people need no WebLogic account; a WAR
	  deployed without the file falls back to the container's login named below.
	  What they may see: Trace's grants and access policy (TraceAccess). What
	  they may change: arming, clearing and saving, and reading the source, need
	  a WebLogic admin role, checked by each endpoint (Operators).
	  There is deliberately no auth-constraint. The container checks one before
	  any filter runs, so a constraint would demand the container's own login of
	  every browser and the OpenID sign-in could never start. login.jsp and
	  denied.jsp stay public: the login form must answer before anyone is
	  signed in, or the FORM login forward loops. Their CSS, logo and favicon
	  come from /blade/portal/brand/*.
	-->
	<filter>
		<filter-name>OidcLoginFilter</filter-name>
		<filter-class>org.vorpal.blade.framework.v3.security.OidcLoginFilter</filter-class>
		<init-param>
			<param-name>publicPaths</param-name>
			<param-value>/login.jsp,/denied.jsp</param-value>
		</init-param>
	</filter>
	<filter-mapping>
		<filter-name>OidcLoginFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<!-- A refusal sent as an error page gets the master page naming the
	     roles that do (admin/portal/denied.jsp). -->
	<error-page>
		<error-code>403</error-code>
		<location>/denied.jsp</location>
	</error-page>

	<login-config>
		<auth-method>CLIENT-CERT,FORM</auth-method>
		<realm-name>default</realm-name>
		<form-login-config>
			<form-login-page>/login.jsp</form-login-page>
			<form-error-page>/login.jsp</form-error-page>
		</form-login-config>
	</login-config>

	<security-role>
		<role-name>Admin</role-name>
	</security-role>
	<security-role>
		<role-name>Operator</role-name>
	</security-role>
	<security-role>
		<role-name>Deployer</role-name>
	</security-role>
	<security-role>
		<role-name>Monitor</role-name>
	</security-role>

	<!-- Static files are re-checked (304 when unchanged), so a redeploy never
	     pairs a new page with a cached old script. -->
	<filter>
		<filter-name>revalidate</filter-name>
		<filter-class>org.vorpal.blade.framework.v3.web.RevalidateFilter</filter-class>
		<async-supported>true</async-supported>
	</filter>
	<filter-mapping>
		<filter-name>revalidate</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

</web-app>
