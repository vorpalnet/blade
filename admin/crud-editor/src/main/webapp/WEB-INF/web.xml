<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	id="WebApp_ID" version="4.0">

	<display-name>crud-editor</display-name>
	<welcome-file-list>
		<welcome-file>crud-editor.html</welcome-file>
	</welcome-file-list>

	<!-- Static files are re-checked (304 when unchanged), so a redeploy never
	     pairs a new page with a cached old script. -->
	<filter>
		<filter-name>revalidate</filter-name>
		<filter-class>org.vorpal.blade.framework.v3.web.RevalidateFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>revalidate</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<servlet>
		<servlet-name>preview</servlet-name>
		<servlet-class>org.vorpal.blade.admin.crud.PreviewServlet</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>preview</servlet-name>
		<url-pattern>/resources/api/preview</url-pattern>
		<url-pattern>/resources/api/selection</url-pattern>
		<url-pattern>/resources/api/ruleSets</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>config</servlet-name>
		<servlet-class>org.vorpal.blade.admin.crud.CrudConfigServlet</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>config</servlet-name>
		<url-pattern>/resources/api/config/*</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>apps</servlet-name>
		<servlet-class>org.vorpal.blade.admin.crud.AppCrudServlet</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>apps</servlet-name>
		<url-pattern>/resources/api/apps/*</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>tests</servlet-name>
		<servlet-class>org.vorpal.blade.admin.crud.CrudTestsServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>tests</servlet-name>
		<url-pattern>/resources/api/tests/*</url-pattern>
	</servlet-mapping>

	<!-- The AI rule builder (RuleBuilderAgent): off until blade-ai.json says on. -->
	<servlet>
		<servlet-name>ai</servlet-name>
		<servlet-class>org.vorpal.blade.admin.crud.RuleBuilderServlet</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>ai</servlet-name>
		<url-pattern>/resources/api/ai</url-pattern>
		<url-pattern>/resources/api/ai/*</url-pattern>
	</servlet-mapping>

	<security-constraint>
		<web-resource-collection>
			<web-resource-name>public-assets</web-resource-name>
			<url-pattern>/login.jsp</url-pattern>
			<url-pattern>/denied.jsp</url-pattern>
			<url-pattern>/favicon.svg</url-pattern>
		</web-resource-collection>
	</security-constraint>

	<security-constraint>
		<web-resource-collection>
			<web-resource-name>API</web-resource-name>
			<url-pattern>/resources/api/*</url-pattern>
			<http-method>GET</http-method>
			<http-method>POST</http-method>
		</web-resource-collection>
		<auth-constraint>
			<role-name>Admin</role-name>
			<role-name>Operator</role-name>
		</auth-constraint>
	</security-constraint>

	<security-constraint>
		<web-resource-collection>
			<web-resource-name>page</web-resource-name>
			<url-pattern>/</url-pattern>
		</web-resource-collection>
		<auth-constraint>
			<role-name>Admin</role-name>
			<role-name>Operator</role-name>
		</auth-constraint>
	</security-constraint>

	<!-- A person signed in without a role that opens this application gets
	     the master page naming the roles that do (admin/portal/denied.jsp). -->
	<error-page>
		<error-code>403</error-code>
		<location>/denied.jsp</location>
	</error-page>

	<login-config>
		<auth-method>CLIENT-CERT,FORM</auth-method>
		<realm-name>default</realm-name>
		<form-login-config>
			<form-login-page>/login.jsp</form-login-page>
			<form-error-page>/login.jsp</form-error-page>
		</form-login-config>
	</login-config>

	<security-role>
		<role-name>Admin</role-name>
	</security-role>
	<security-role>
		<role-name>Operator</role-name>
	</security-role>
</web-app>
